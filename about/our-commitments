<style>
:root {
  --teal: #16768C; --teal-dark: #144E73; --teal-light: #A3D2D8;
  --charcoal: #2C2C2C; --off-white: #F8F8F8; --white: #FFFFFF;
  --text: #1A1A1A; --text-sec: #63615D; --border: #E2E0DA;
  --font-display: 'Oswald', sans-serif; --font-body: 'Poppins', sans-serif;
  --max-width: 1160px; --section-pad: 100px 32px;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; font-family: var(--font-body); font-weight: 300; color: var(--text); background: var(--off-white); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
img, svg { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
h1, h2, h3 { font-family: var(--font-display); margin: 0; font-weight: 600; }
p { margin: 0; }
ul { margin: 0; padding: 0; list-style: none; }
button { font-family: var(--font-body); cursor: pointer; }
:focus-visible { outline: 3px solid var(--teal); outline-offset: 3px; }
.wrap { max-width: var(--max-width); margin: 0 auto; padding: 0 32px; }
section { padding: var(--section-pad); position: relative; }
.bg-charcoal { background: var(--charcoal); }
.bg-white { background: var(--white); }
.bg-offwhite { background: var(--off-white); }

.eyebrow { display: flex; align-items: center; gap: 14px; font-weight: 600; font-size: 0.72rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--teal); margin-bottom: 24px; }
.eyebrow::before { content: ""; display: inline-block; width: 36px; height: 2px; background: var(--teal); flex-shrink: 0; }
.eyebrow.on-dark { color: var(--teal-light); }
.eyebrow.on-dark::before { background: var(--teal-light); }

.btn { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 0.85rem; letter-spacing: 0.04em; padding: 16px 30px; border: 1.5px solid transparent; transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease; }
.btn-teal { background: var(--teal); color: var(--white); }
.btn-teal:hover { background: var(--teal-dark); transform: translateY(-1px); }
.btn-ghost { border-color: rgba(255,255,255,0.45); color: var(--white); }
.btn-ghost:hover { border-color: var(--white); transform: translateY(-1px); }
.btn-ghost-dark { border-color: var(--charcoal); color: var(--charcoal); }
.btn-ghost-dark:hover { background: var(--charcoal); color: var(--white); }
.btn svg { transition: transform 0.2s ease; }
.btn:hover svg { transform: translateX(3px); }

/* NAV */
.site-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 300; display: flex; align-items: center; justify-content: space-between; padding: 20px 32px; background: rgba(248,248,248,0.94); backdrop-filter: blur(10px); box-shadow: 0 1px 0 var(--border); }
.logo-mark img { height: 26px; width: auto; }
.nav-links { display: flex; align-items: center; gap: 40px; }
.nav-link { position: relative; font-weight: 500; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--charcoal); padding-bottom: 6px; }
.nav-link.active { color: var(--teal-dark); }
.nav-link::after { content: ""; position: absolute; left: 0; bottom: 0; width: 0; height: 1.5px; background: var(--teal); transition: width 0.2s ease; }
.nav-link:hover::after, .nav-link.active::after { width: 100%; }
.nav-cta { margin-left: 8px; padding: 12px 24px; }
.hamburger { display: none; background: none; border: none; width: 32px; height: 32px; position: relative; z-index: 310; cursor: pointer; }
.hamburger span { display: block; position: absolute; left: 4px; right: 4px; height: 2px; background: var(--charcoal); transition: all 0.25s ease; }
.hamburger span:nth-child(1) { top: 10px; } .hamburger span:nth-child(2) { top: 16px; } .hamburger span:nth-child(3) { top: 22px; }
.hamburger.open span:nth-child(1) { top: 16px; transform: rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; }
.hamburger.open span:nth-child(3) { top: 16px; transform: rotate(-45deg); }
.mobile-menu { position: fixed; inset: 0; background: var(--off-white); z-index: 290; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 36px; transform: translateY(-100%); opacity: 0; visibility: hidden; transition: transform 0.35s ease, opacity 0.3s ease, visibility 0.35s; }
.mobile-menu.open { transform: translateY(0); opacity: 1; visibility: visible; }
.mobile-menu a { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: var(--charcoal); }
@media (max-width: 860px) { .nav-links { display: none; } .hamburger { display: block; } }

.reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
.reveal.visible { opacity: 1; transform: translateY(0); }
@media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } html { scroll-behavior: auto; } }

.page-hero { padding: 158px 32px 70px; }
.page-hero h1 { font-size: clamp(2rem, 4.2vw, 3.1rem); line-height: 1.2; color: var(--charcoal); max-width: 760px; }
.page-hero .support { font-size: 1.02rem; color: var(--text-sec); max-width: 600px; margin-top: 24px; line-height: 1.8; }

/* VALUE LIST */
.value-list { display: flex; flex-direction: column; }
.value-row { display: grid; grid-template-columns: 50px 2fr 3fr; gap: 28px; padding: 32px 0; border-top: 1px solid rgba(255,255,255,0.14); align-items: baseline; }
.value-list .value-row:last-child { border-bottom: 1px solid rgba(255,255,255,0.14); }
.value-row .num { font-family: var(--font-display); font-weight: 600; color: var(--teal-light); font-size: 0.95rem; }
.value-row h3 { font-size: 1.2rem; color: var(--white); font-weight: 500; }
.value-row p { font-size: 0.94rem; color: rgba(255,255,255,0.62); line-height: 1.75; }
@media (max-width: 760px) { .value-row { grid-template-columns: 1fr; gap: 8px; } .value-row .num { display: none; } }

/* OPERATIONAL COMMITMENTS */
.op-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: var(--border); border: 1px solid var(--border); }
.op-card { background: var(--white); padding: 40px 38px; }
.op-card .tag { font-family: var(--font-display); font-weight: 600; font-size: 0.72rem; letter-spacing: 0.1em; color: var(--teal); display: block; margin-bottom: 16px; }
.op-card h3 { font-size: 1.25rem; color: var(--charcoal); margin-bottom: 14px; }
.op-card p { font-size: 0.95rem; color: var(--text-sec); line-height: 1.8; }
.op-card a.op-link { display: inline-block; margin-top: 18px; font-size: 0.85rem; font-weight: 600; color: var(--teal-dark); text-decoration: underline; text-underline-offset: 3px; }
@media (max-width: 760px) { .op-grid { grid-template-columns: 1fr; } }

.cta-band { text-align: center; }
.cta-band h2 { font-size: clamp(1.6rem, 2.8vw, 2.2rem); color: var(--white); max-width: 640px; margin: 0 auto; line-height: 1.35; }
.cta-band .cta-row { margin-top: 36px; display: flex; justify-content: center; gap: 18px; flex-wrap: wrap; }

footer { background: var(--charcoal); padding: 72px 32px 32px; }
.footer-inner { max-width: var(--max-width); margin: 0 auto; }
.footer-top { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 40px; padding-bottom: 44px; border-bottom: 1px solid rgba(255,255,255,0.1); }
.footer-brand img { height: 24px; width: auto; }
.footer-tag { font-size: 0.85rem; color: rgba(255,255,255,0.4); margin-top: 14px; max-width: 300px; line-height: 1.6; }
.footer-cols { display: flex; gap: 64px; flex-wrap: wrap; }
.footer-cols h4 { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 18px; font-weight: 600; }
.footer-cols ul { display: flex; flex-direction: column; gap: 12px; }
.footer-cols a { color: rgba(255,255,255,0.62); font-size: 0.92rem; }
.footer-cols a:hover { color: var(--white); }
.footer-bottom { padding-top: 28px; color: rgba(255,255,255,0.35); font-size: 0.78rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
.back-to-top { position: fixed; right: 28px; bottom: 28px; width: 46px; height: 46px; background: var(--charcoal); display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s, background 0.2s; cursor: pointer; border: none; z-index: 99; }
.back-to-top.visible { opacity: 1; visibility: visible; }
.back-to-top:hover { background: var(--teal); }
@media (max-width: 640px) { .page-hero { padding: 136px 22px 50px; } }
</style>
